# Modo local: dados persistidos em data/demo.json. Não usar na Vercel.
DEMO_MODE=true
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=substitua-por-um-segredo-aleatorio-com-32-caracteres
SUPERVISOR_EMAIL=supervisor@logtrack.local
SUPERVISOR_PASSWORD=substitua-por-uma-senha-forte
# Produção: DEMO_MODE=false e PostgreSQL Supabase.
DATABASE_URL=postgresql://postgres:SENHA@HOST:5432/postgres
DIRECT_URL=postgresql://postgres:SENHA@HOST:5432/postgres

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Supervisor {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(255)
  senhaHash String @map("senha_hash")
  nome String @db.VarChar(255)
  criadoEm DateTime @default(now()) @map("criado_em")
  @@map("supervisores")
}
model Zona {
  id String @id @default(uuid()) @db.Uuid
  nome String @unique @db.VarChar(100)
  descricao String?
  ativa Boolean @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")
  celulares Celular[]
  lotes Lote[]
  origens Movimentacao[] @relation("origem")
  destinos Movimentacao[] @relation("destino")
  @@map("zonas")
}
model Celular {
  id String @id @default(uuid()) @db.Uuid
  nome String @db.VarChar(100)
  zonaId String @db.Uuid @map("zona_id")
  zona Zona @relation(fields:[zonaId], references:[id], onDelete:Restrict)
  tokenCookie String @unique @map("token_cookie")
  ativo Boolean @default(true)
  ultimoUso DateTime? @map("ultimo_uso")
  criadoEm DateTime @default(now()) @map("criado_em")
  lotes Lote[]
  movimentacoes Movimentacao[]
  @@index([zonaId])
  @@map("celulares")
}
model Lote {
  id String @id @default(uuid()) @db.Uuid
  codigo String @unique @db.VarChar(100)
  descricao String?
  quantidade Int?
  dataValidade DateTime? @db.Date @map("data_validade")
  zonaAtualId String? @db.Uuid @map("zona_atual_id")
  zonaAtual Zona? @relation(fields:[zonaAtualId], references:[id], onDelete:Restrict)
  ultimoCelularId String? @db.Uuid @map("ultimo_celular_id")
  ultimoCelular Celular? @relation(fields:[ultimoCelularId], references:[id], onDelete:Restrict)
  tagGravada Boolean @default(false) @map("tag_gravada")
  arquivado Boolean @default(false)
  criadoEm DateTime @default(now()) @map("criado_em")
  movimentacoes Movimentacao[]
  @@index([zonaAtualId])
  @@index([dataValidade])
  @@map("lotes")
}
enum TipoMovimentacao {
  MOVIMENTO
  CANCELAMENTO
}
model Movimentacao {
  id String @id @default(uuid()) @db.Uuid
  loteId String @db.Uuid @map("lote_id")
  lote Lote @relation(fields:[loteId], references:[id], onDelete:Restrict)
  zonaOrigemId String? @db.Uuid @map("zona_origem_id")
  zonaOrigem Zona? @relation("origem", fields:[zonaOrigemId], references:[id], onDelete:Restrict)
  zonaDestinoId String? @db.Uuid @map("zona_destino_id")
  zonaDestino Zona? @relation("destino", fields:[zonaDestinoId], references:[id], onDelete:Restrict)
  celularId String @db.Uuid @map("celular_id")
  celular Celular @relation(fields:[celularId], references:[id], onDelete:Restrict)
  tipo TipoMovimentacao
  timestamp DateTime @default(now())
  @@index([loteId, timestamp])
  @@map("movimentacoes")
}
model Leitura {
  id String @id @db.Uuid
  loteId String @db.Uuid @map("lote_id")
  celularId String? @db.Uuid @map("celular_id")
  modo String
  resultado Json
  timestamp DateTime @default(now())
  @@index([loteId, timestamp])
  @@map("leituras")
}

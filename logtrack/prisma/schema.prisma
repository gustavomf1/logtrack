generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Supervisor {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(255)
  senhaHash String @map("senha_hash")
  nome String @db.VarChar(255)
  criadoEm DateTime @default(now()) @map("criado_em")
  @@map("supervisores")
}
model Zona {
  id String @id @default(uuid()) @db.Uuid
  nome String @unique @db.VarChar(100)
  descricao String?
  ativa Boolean @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")
  portais Portal[]
  lotes Lote[]
  origens Movimentacao[] @relation("origem")
  destinos Movimentacao[] @relation("destino")
  zonasMapa ZonaMapa[]
  @@map("zonas")
}
model Portal {
  id String @id @default(uuid()) @db.Uuid
  nome String @db.VarChar(100)
  zonaId String @db.Uuid @map("zona_id")
  zona Zona @relation(fields:[zonaId], references:[id], onDelete:Restrict)
  tokenCookie String @unique @map("token_cookie")
  ativo Boolean @default(true)
  ultimoUso DateTime? @map("ultimo_uso")
  criadoEm DateTime @default(now()) @map("criado_em")
  lotes Lote[]
  estacoesMapa EstacaoMapa[]
  movimentacoes Movimentacao[]
  @@index([zonaId])
  @@map("portais")
}
model Lote {
  id String @id @default(uuid()) @db.Uuid
  codigo String @unique @db.VarChar(100)
  descricao String?
  quantidade Int?
  dataValidade DateTime? @db.Date @map("data_validade")
  zonaAtualId String? @db.Uuid @map("zona_atual_id")
  zonaAtual Zona? @relation(fields:[zonaAtualId], references:[id], onDelete:Restrict)
  ultimoPortalId String? @db.Uuid @map("ultimo_portal_id")
  ultimoPortal Portal? @relation(fields:[ultimoPortalId], references:[id], onDelete:Restrict)
  tagGravada Boolean @default(false) @map("tag_gravada")
  arquivado Boolean @default(false)
  criadoEm DateTime @default(now()) @map("criado_em")
  movimentacoes Movimentacao[]
  @@index([zonaAtualId])
  @@index([dataValidade])
  @@map("lotes")
}
enum TipoMovimentacao {
  MOVIMENTO
  CANCELAMENTO
}
model Movimentacao {
  id String @id @default(uuid()) @db.Uuid
  loteId String @db.Uuid @map("lote_id")
  lote Lote @relation(fields:[loteId], references:[id], onDelete:Restrict)
  zonaOrigemId String? @db.Uuid @map("zona_origem_id")
  zonaOrigem Zona? @relation("origem", fields:[zonaOrigemId], references:[id], onDelete:Restrict)
  zonaDestinoId String? @db.Uuid @map("zona_destino_id")
  zonaDestino Zona? @relation("destino", fields:[zonaDestinoId], references:[id], onDelete:Restrict)
  portalId String @db.Uuid @map("portal_id")
  portal Portal @relation(fields:[portalId], references:[id], onDelete:Restrict)
  tipo TipoMovimentacao
  timestamp DateTime @default(now())
  @@index([loteId, timestamp])
  @@map("movimentacoes")
}
model Leitura {
  id String @id @db.Uuid
  loteId String @db.Uuid @map("lote_id")
  portalId String? @db.Uuid @map("portal_id")
  modo String
  resultado Json
  timestamp DateTime @default(now())
  @@index([loteId, timestamp])
  @@map("leituras")
}
model Mapa {
  id           String        @id @default(uuid()) @db.Uuid
  nome         String        @db.VarChar(100)
  imagemUrl    String?       @map("imagem_url")
  larguraBase  Int?          @map("largura_base")
  alturaBase   Int?          @map("altura_base")
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")
  estacoes     EstacaoMapa[]
  textos       TextoMapa[]
  zonas        ZonaMapa[]
  @@map("mapas")
}
model EstacaoMapa {
  id        String   @id @default(uuid()) @db.Uuid
  mapaId    String   @db.Uuid @map("mapa_id")
  mapa      Mapa     @relation(fields:[mapaId], references:[id], onDelete:Cascade)
  portalId  String   @db.Uuid @map("portal_id")
  portal    Portal   @relation(fields:[portalId], references:[id], onDelete:Cascade)
  apelido   String?  @db.VarChar(100)
  x         Float
  y         Float
  rotacao   Float    @default(0)
  criadoEm  DateTime @default(now()) @map("criado_em")
  @@unique([mapaId, portalId])
  @@map("estacoes_mapa")
}
model TextoMapa {
  id       String   @id @default(uuid()) @db.Uuid
  mapaId   String   @db.Uuid @map("mapa_id")
  mapa     Mapa     @relation(fields:[mapaId], references:[id], onDelete:Cascade)
  texto    String   @db.VarChar(200)
  x        Float
  y        Float
  criadoEm DateTime @default(now()) @map("criado_em")
  @@index([mapaId])
  @@map("textos_mapa")
}
model ZonaMapa {
  id       String   @id @default(uuid()) @db.Uuid
  mapaId   String   @db.Uuid @map("mapa_id")
  mapa     Mapa     @relation(fields:[mapaId], references:[id], onDelete:Cascade)
  zonaId   String   @db.Uuid @map("zona_id")
  zona     Zona     @relation(fields:[zonaId], references:[id], onDelete:Cascade)
  x        Float
  y        Float
  criadoEm DateTime @default(now()) @map("criado_em")
  @@unique([mapaId, zonaId])
  @@map("zonas_mapa")
}
